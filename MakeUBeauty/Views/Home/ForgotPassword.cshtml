@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Make U Beauty</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
            :root {
                --system-maroon: #640D14;
                --system-gold: #C5A059;
                --glass-white: rgba(255, 255, 255, 0.15);
            }

            body, html {
                height: 100%;
                margin: 0;
                font-family: 'Poppins', sans-serif;
                background: linear-gradient(135deg, #431215 0%, #640D14 50%, #2b080a 100%);
                overflow: hidden;
            }

            .auth-container {
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .glass-box {
                background: rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(15px);
                -webkit-backdrop-filter: blur(15px);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 24px;
                padding: 40px;
                width: 100%;
                max-width: 420px;
                text-align: center;
                color: white;
                box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
            }

            .font-playfair {
                font-family: 'Playfair Display', serif;
            }

            .brand-logo {
                font-size: 2rem;
                letter-spacing: 2px;
                color: white;
                margin-bottom: 30px;
            }

            .text-gold {
                color: var(--system-gold);
            }

            .recovery-icon-circle {
                width: 70px;
                height: 70px;
                background: var(--glass-white);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 25px;
                font-size: 1.8rem;
                color: var(--system-gold);
                border: 1px solid rgba(255,255,255,0.2);
            }

            .glass-input-group {
                position: relative;
                margin-bottom: 20px;
            }

                .glass-input-group i {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: rgba(255, 255, 255, 0.6);
                }

                .glass-input-group input {
                    width: 100%;
                    background: rgba(255, 255, 255, 0.1);
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    border-radius: 12px;
                    padding: 12px 15px 12px 45px;
                    color: white;
                    outline: none;
                    transition: 0.3s;
                }

                    .glass-input-group input:focus {
                        background: rgba(255, 255, 255, 0.15);
                        border-color: var(--system-gold);
                        box-shadow: 0 0 10px rgba(197, 160, 89, 0.2);
                    }

                    .glass-input-group input::placeholder {
                        color: rgba(255, 255, 255, 0.4);
                        font-size: 0.9rem;
                    }

            .btn-maroon-auth {
                background: var(--system-gold);
                color: #2b080a;
                border: none;
                width: 100%;
                padding: 14px;
                border-radius: 12px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 1px;
                transition: 0.3s;
                margin-top: 10px;
            }

                .btn-maroon-auth:hover {
                    background: #e3b685;
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
                }

            .back-link {
                transition: 0.3s;
                font-size: 0.85rem;
                color: rgba(255,255,255,0.6) !important;
            }

                .back-link:hover {
                    color: white !important;
                    transform: translateX(-3px);
                }
    </style>
</head>
<body>

    <div class="auth-container">
        <div class="glass-box">
            <div class="text-start mb-4">
                <a asp-controller="Home" asp-action="Login" class="back-link text-decoration-none d-inline-block">
                    <i class="fas fa-arrow-left me-1"></i> Back to Sign In
                </a>
            </div>

            <h2 class="brand-logo fw-bold font-playfair">Make U Beauty</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success text-center mb-3" style="background: rgba(40,167,69,0.2); border: none; color: #90ee90; border-radius: 10px;">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger text-center mb-3" style="background: rgba(220,53,69,0.2); border: none; color: #ff8080; border-radius: 10px;">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            <div class="recovery-icon-circle">
                <i class="fas fa-key"></i>
            </div>

            <h5 class="mb-1 fw-bold">Forgot Password?</h5>
            <p class="small mb-4" style="color: rgba(255,255,255,0.6);">
                No worries! Enter your email and we'll send you a secure recovery link.
            </p>

            <form asp-controller="Home" asp-action="ForgotPassword" method="post" class="text-start">
                <label class="small fw-bold text-uppercase mb-2 ms-1" style="font-size: 0.7rem; color: var(--system-gold); letter-spacing: 1px;">
                    Email Address
                </label>
                <div class="glass-input-group">
                    <i class="far fa-envelope"></i>
                    <input type="email" name="Email" value="" placeholder="e.g. jane.doe@example.com" required>
                </div>

                <button type="submit" class="btn-maroon-auth">Send Recovery Link</button>
            </form>

            <div class="mt-4 pt-2 border-top border-white border-opacity-10">
                <p class="extra-small mb-0" style="font-size: 0.75rem; color: rgba(255,255,255,0.5);">
                    Need help? <a asp-controller="Home" asp-action="Contact" class="text-gold text-decoration-none">Contact Support</a>
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>