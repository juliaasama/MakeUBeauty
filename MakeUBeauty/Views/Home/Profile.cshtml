@model MakeUBeauty.Models.User
@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-page bg-light-creme min-vh-100 pb-5">
    <div class="bg-maroon-gradient" style="height: 200px;"></div>

    <div class="container" style="margin-top: -100px; max-width: 850px;">

        <div class="card shadow-sm border-0 rounded-4 mb-4 text-center p-4 animate__animated animate__fadeIn">
            <div class="position-relative d-inline-block mx-auto">
                <img id="profilePreview"
                     src="@(string.IsNullOrEmpty(Model.ProfilePicture) ? "/images/default-avatar.png" : "/images/profiles/" + Model.ProfilePicture)"
                     class="rounded-circle border border-4 border-white shadow-sm"
                     style="width: 140px; height: 140px; object-fit: cover; background-color: #dcd7cc;" />

                <label for="imageUpload" class="btn btn-maroon position-absolute rounded-circle shadow edit-mode-only"
                       style="display:none; bottom: 8px; right: 8px; width: 42px; height: 42px;
                    display: flex; align-items: center; justify-content: center; cursor: pointer; border: 3px solid white;">
                    <i class="fa fa-camera text-white"></i>
                </label>
            </div>
            <h2 class="mt-3 fw-bold mb-1 font-playfair text-maroon">@Model.Name</h2>
            <p class="text-muted small text-uppercase tracking-widest">Member since @DateTime.Now.Year</p>
        </div>

        <div class="row g-3 mb-4">
            @{
                var stats = new[] {
                    new { Icon = "fa-heart", Label = "Wishlist", Color = "text-danger", Action = "Wishlist" },
                    new { Icon = "fa-shopping-cart", Label = "In Cart", Color = "text-maroon", Action = "Cart" },
                    new { Icon = "fa-box", Label = "Orders", Color = "text-success", Action = "Orders" }
                };
            }
            @foreach (var stat in stats)
            {
                <div class="col-4">
                    <a asp-action="@stat.Action" class="text-decoration-none h-100">
                        <div class="card shadow-sm border-0 rounded-4 text-center p-3 h-100 hover-lift">
                            <i class="fa @stat.Icon fs-4 mb-2 @stat.Color"></i>
                            <div class="fw-bold text-dark mb-0" style="font-size: 0.85rem; letter-spacing: 1px;">@stat.Label.ToUpper()</div>
                        </div>
                    </a>
                </div>
            }
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center mb-3"
                 style="background: rgba(40,167,69,0.2); color:#90ee90; border:none;">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="UpdateProfile" asp-controller="Home" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="file" id="imageUpload" name="profileImage" class="d-none" onchange="previewImage(event)" />

            <div class="card shadow-sm border-0 rounded-4 p-4 animate__animated animate__fadeInUp">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h5 class="fw-bold m-0 font-playfair text-maroon">
                        <i class="fa fa-user-circle me-2"></i>Personal Details
                    </h5>

                    <div id="viewButtons">
                        <button type="button" class="btn btn-outline-dark btn-sm px-4 rounded-pill fw-bold" onclick="toggleEdit(true)">
                            <i class="fa fa-edit me-1"></i> EDIT PROFILE
                        </button>
                    </div>

                    <div id="editButtons" style="display:none;">
                        <button type="submit" class="btn btn-maroon btn-sm px-4 rounded-pill me-2 shadow-sm fw-bold">SAVE CHANGES</button>
                        <button type="button" class="btn btn-light border btn-sm px-4 rounded-pill fw-bold" onclick="toggleEdit(false)">CANCEL</button>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase mb-1 tracking-widest">Full Name</label>
                        <div class="view-mode-text fw-semibold p-2 border-start border-3 border-gold-light bg-light rounded-1">@Model.Name</div>
                        <input asp-for="Name" class="form-control bg-light border-0 edit-mode-input p-2" style="display:none;" />
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase mb-1 tracking-widest">Phone Number</label>
                        <div class="view-mode-text fw-semibold p-2 border-start border-3 border-gold-light bg-light rounded-1">@(Model.PhoneNumber ?? "Not provided")</div>
                        <input asp-for="PhoneNumber" class="form-control bg-light border-0 edit-mode-input p-2" style="display:none;" placeholder="09XX XXX XXXX" />
                    </div>

                    <div class="col-md-12">
                        <label class="text-muted small fw-bold text-uppercase mb-1 tracking-widest">Gender Preference</label>
                        <div class="view-mode-text fw-semibold p-2 border-start border-3 border-gold-light bg-light rounded-1">@(Model.Gender ?? "Not specified")</div>
                        <select asp-for="Gender" class="form-select bg-light border-0 edit-mode-input p-2" style="display:none;">
                            <option value="">Select Gender</option>
                            <option value="Female">Female</option>
                            <option value="Male">Male</option>
                            <option value="Non-binary">Non-binary</option>
                            <option value="Other">Prefer not to say</option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="text-muted small fw-bold text-uppercase mb-1 tracking-widest">Personal Bio</label>
                        <div class="view-mode-text fw-semibold p-3 italic text-secondary bg-light rounded-3 border-start border-3 border-maroon">
                            "@(Model.Bio ?? "Your beauty journey starts here. Add a bio to tell us more about yourself.")"
                        </div>
                        <textarea asp-for="Bio" class="form-control bg-light border-0 edit-mode-input p-3"
                                  style="display:none; height: 120px;" placeholder="Tell us about your beauty routine..."></textarea>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    :root {
        --system-maroon: #640D14;
        --maroon-dark: #431215;
        --gold-light: #E3B685;
        --system-gold: #C5A059;
    }

    .font-playfair {
        font-family: 'Playfair Display', serif;
    }

    .text-maroon {
        color: var(--system-maroon);
    }

    .bg-maroon-gradient {
        background: linear-gradient(135deg, var(--maroon-dark) 0%, var(--system-maroon) 100%);
    }

    .tracking-widest {
        letter-spacing: 1.5px;
        font-size: 0.7rem;
    }

    .border-gold-light {
        border-color: var(--gold-light) !important;
    }

    .btn-maroon {
        background-color: var(--system-maroon);
        color: white;
        border: none;
        transition: 0.3s;
    }

        .btn-maroon:hover {
            background-color: var(--maroon-dark);
            color: var(--gold-light);
        }

    .bg-light-creme {
        background-color: #fcfbf9;
    }

    .hover-lift {
        transition: 0.3s;
    }

        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }

    .italic {
        font-style: italic;
    }

    .edit-mode-input:focus {
        background-color: white !important;
        box-shadow: 0 0 0 0.25rem rgba(100, 13, 20, 0.1);
        border: 1px solid var(--gold-light) !important;
    }
</style>

@section Scripts {
    <script>
        function toggleEdit(isEditing) {
            $('#viewButtons').toggle(!isEditing);
            $('#editButtons').toggle(isEditing);

            $('.edit-mode-only').toggle(isEditing);

            $('.view-mode-text').toggle(!isEditing);
            $('.edit-mode-input').toggle(isEditing);
        }

        function previewImage(event) {
            if (event.target.files && event.target.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    $('#profilePreview').fadeOut(200, function() {
                        $(this).attr('src', e.target.result).fadeIn(200);
                    });
                };
                reader.readAsDataURL(event.target.files[0]);
            }
        }
    </script>
}