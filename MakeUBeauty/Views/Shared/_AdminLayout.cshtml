<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Make U Beauty Admin
    </title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;600&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

            :root {
                --sidebar-bg: #640D14;
                --gold-accent: #E3B685;
                --sidebar-width: 280px;
                --transition-speed: 0.3s;
            }


            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f4f7f6;
                overflow-x: hidden;
            }

            .font-playfair {
                font-family: 'Playfair Display', serif;
            }

            #sidebar-wrapper {
                width: var(--sidebar-width);
                background-color: var(--sidebar-bg);
                transition: all var(--transition-speed);
                z-index: 1000;
                border-right: 1px solid rgba(227, 182, 133, 0.1);
            }

            .sidebar-heading {
                padding: 2.5rem 1.5rem;
                text-align: center;
            }

            .brand-logo {
                font-size: 1.5rem;
                color: var(--gold-accent);
                letter-spacing: -1px;
                text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
            }

            .sidebar-nav-label {
                font-size: 0.65rem;
                text-transform: uppercase;
                letter-spacing: 2px;
                color: rgba(255, 255, 255, 0.4);
                padding: 0 25px;
                margin-bottom: 15px;
            }

            .sidebar-item {
                padding: 14px 25px;
                color: rgba(255, 255, 255, 0.7) !important;
                border: none;
                background: transparent;
                margin: 4px 15px;
                border-radius: 12px;
                font-size: 0.85rem;
                font-weight: 400;
                transition: all 0.2s ease;
                text-decoration: none;
            }

                .sidebar-item i {
                    width: 20px;
                    text-align: center;
                    font-size: 1.1rem;
                }

                .sidebar-item:hover {
                    color: #fff !important;
                    background: rgba(255, 255, 255, 0.08);
                    transform: translateX(5px);
                }

            .active-glass {
                background: rgba(255, 255, 255, 0.12) !important;
                backdrop-filter: blur(8px);
                color: var(--gold-accent) !important;
                font-weight: 600;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                position: relative;
            }

                .active-glass::after {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 25%;
                    height: 50%;
                    width: 4px;
                    background: var(--gold-accent);
                    border-radius: 0 4px 4px 0;
                }

            #page-content-wrapper {
                width: 100%;
                min-height: 100vh;
                margin-left: var(--sidebar-width);
                transition: all var(--transition-speed);
            }

            .admin-navbar {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(5px);
                border-bottom: 1px solid rgba(0, 0, 0, 0.05);
                padding: 1rem 2rem;
            }

            .exit-btn {
                background: var(--sidebar-bg);
                color: white !important;
                border-radius: 50px;
                padding: 8px 24px;
                font-size: 0.7rem;
                font-weight: 700;
                letter-spacing: 1.5px;
                border: 2px solid transparent;
                transition: 0.3s;
            }

                .exit-btn:hover {
                    background: transparent;
                    color: var(--sidebar-bg) !important;
                    border-color: var(--sidebar-bg);
                    transform: translateY(-2px);
                }


            @@media (max-width: 992px) {

                #sidebar-wrapper {
                    margin-left: calc(-1 * var(--sidebar-width));
                }

                #page-content-wrapper {
                    margin-left: 0;
                }

                #wrapper.toggled #sidebar-wrapper {
                    margin-left: 0;
                }
            }

    </style>

</head>

<body class="admin-body">

    <div class="d-flex" id="wrapper">

        <div class="vh-100 position-fixed shadow-lg d-flex flex-column"
             id="sidebar-wrapper">

            <div class="sidebar-heading">

                <div class="brand-logo font-playfair mb-1">
                    Make U Beauty
                </div>

                <div class="text-white-50 small text-uppercase fw-bold"
                     style="letter-spacing: 3px; font-size: 0.55rem;">

                    Admin Management

                </div>

            </div>

            <div class="mt-4 flex-grow-1">

                <p class="sidebar-nav-label">
                    Navigation
                </p>

                <div class="list-group list-group-flush border-0">

                    @{
                        var currentAction =
                        ViewContext.RouteData.Values["Action"]?.ToString();
                    }

                    <a asp-controller="Admin"
                           asp-action="Index"
                           class="list-group-item d-flex align-items-center sidebar-item @(currentAction == "Index" ? "active-glass" : "")">

                        <i class="fas fa-th-large me-3"></i>
                        Dashboard

                    </a>

                    <a asp-controller="Admin"
                           asp-action="Products"
                           class="list-group-item d-flex align-items-center sidebar-item @(currentAction == "Products" ? "active-glass" : "")">

                        <i class="fas fa-box-open me-3"></i>
                        Inventory

                    </a>

                    <a asp-controller="Admin"
                           asp-action="Orders"
                           class="list-group-item d-flex align-items-center sidebar-item @(currentAction == "Orders" ? "active-glass" : "")">

                        <i class="fas fa-shopping-bag me-3"></i>
                        Order List

                    </a>

                    <a asp-controller="Admin"
                           asp-action="Customers"
                           class="list-group-item d-flex align-items-center sidebar-item @(currentAction == "Customers" ? "active-glass" : "")">

                        <i class="fas fa-users me-3"></i>
                        Customer Data

                    </a>

                </div>

            </div>

            <div class="p-4 mt-auto">

                <div class="text-white-50 text-center mt-3"
                     style="font-size: 0.6rem; opacity: 0.5;">

                    &copy; 2026 MakeUBeauty

                </div>

            </div>

        </div>

        <div id="page-content-wrapper">

            <nav class="navbar navbar-expand-lg admin-navbar sticky-top">

                <div class="container-fluid">

                    <button class="btn btn-light d-lg-none me-3"
                            id="menu-toggle">

                        <i class="fas fa-bars"></i>

                    </button>

                    <div class="d-none d-md-block">

                        <h6 class="mb-0 fw-bold text-dark">

                            Make U Beauty

                            <span class="fw-light text-muted ms-1">
                                | Intelligence Console
                            </span>

                        </h6>

                    </div>

                    <div class="ms-auto d-flex align-items-center gap-3">

                        <a asp-controller="Admin"
                               asp-action="ExitAdmin"
                               class="exit-btn d-inline-flex align-items-center">

                            <i class="fas fa-sign-out-alt me-2"></i>
                            TERMINATE SESSION

                        </a>

                    </div>

                </div>

            </nav>


            <div class="container-fluid p-4 px-lg-5">

                @RenderBody()

            </div>

        </div>

    </div>



    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $("#menu-toggle").click(function (e) {

        e.preventDefault();

        $("#wrapper").toggleClass("toggled");
        });


        function exitAdmin() {

        Swal.fire({
        title: 'Terminate session?',
        text: "You will be logged out.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Logout'
        }).then((result) => {

        if (result.isConfirmed) {

        window.location.href = '/Admin/ExitAdmin';
        }
        });
        }


        function confirmLogout() {

        Swal.fire({
        title: 'Terminate session?',
        text: "You will be logged out from admin.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#640D14',
        confirmButtonText: 'Yes, logout'
        }).then((result) => {

        if (result.isConfirmed) {

        window.location.href = '/Admin/ExitAdmin';
        }
        });
        }

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>